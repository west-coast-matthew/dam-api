#!/usr/bin/env bash
# Build dam-api and launch the executable jar.
#
# Runtime config is read from /etc/app-config/dam/application.properties
# (override with DAM_CONFIG=/path/to/application.properties).
#
# Usage: bin/deploy [--skip-tests] [extra spring args...]
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="${DAM_CONFIG:-/etc/app-config/dam/application.properties}"

MVN_ARGS=(-B clean package)
if [[ "${1:-}" == "--skip-tests" ]]; then
  MVN_ARGS+=(-DskipTests)
  shift
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "ERROR: config file not found: $CONFIG_FILE" >&2
  echo "Create it from the sample:" >&2
  echo "  sudo mkdir -p $(dirname "$CONFIG_FILE")" >&2
  echo "  sudo cp $PROJECT_DIR/config/application.properties.sample $CONFIG_FILE" >&2
  exit 1
fi

cd "$PROJECT_DIR"

# Prefer an installed Maven; fall back to the project wrapper
if command -v mvn >/dev/null 2>&1; then
  MVN=mvn
else
  MVN=./mvnw
fi

echo ">> Building with $MVN ${MVN_ARGS[*]}"
"$MVN" "${MVN_ARGS[@]}"

JAR="$(ls target/dam-api-*.jar | grep -v '\.original$' | head -n 1)"
if [[ -z "$JAR" ]]; then
  echo "ERROR: no jar found in target/" >&2
  exit 1
fi

echo ">> Launching $JAR with config $CONFIG_FILE"
# additional-location keeps the defaults bundled in the jar and layers the
# external file on top of them
exec java -jar "$JAR" \
  --spring.config.additional-location="file:$CONFIG_FILE" \
  "$@"
